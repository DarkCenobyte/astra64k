set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
find_program(ASTRA_MINGW_CC NAMES x86_64-w64-mingw32-gcc x86_64-w64-mingw32-gcc-posix REQUIRED)
find_program(ASTRA_MINGW_RC NAMES x86_64-w64-mingw32-windres REQUIRED)
find_program(ASTRA_MINGW_OBJDUMP NAMES x86_64-w64-mingw32-objdump REQUIRED)
set(CMAKE_C_COMPILER "${ASTRA_MINGW_CC}")
set(CMAKE_RC_COMPILER "${ASTRA_MINGW_RC}")
set(CMAKE_OBJDUMP "${ASTRA_MINGW_OBJDUMP}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
